# Environment variables for Backend
BACKEND_PORT=3000
ELECTRON_CDP_PORT=8315
VITE_DEV_PORT=5173

# NVIDIA NIM — system-wide fallback key used for ALL NVIDIA models when the
# user hasn't configured a model-specific or global key in Settings.
NVIDIA_DEFAULT_API_KEY=

# NVIDIA NIM — optional per-model system keys (see backend/nvidiaModels.js MODELS).
# Rarely needed: NVIDIA_DEFAULT_API_KEY above already covers every model.
NVIDIA_KEY_LLAMA=
NVIDIA_KEY_ISING=
NVIDIA_KEY_QWEN=
NVIDIA_KEY_GEMMA=
NVIDIA_KEY_GLM=
NVIDIA_KEY_LLAMA_VISION=
NVIDIA_KEY_NEMOTRON_V2=
NVIDIA_KEY_NEMOTRON_VL=
TOGETHER_API_KEY=
