{
  "name": "wacopilote",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && npm run electron:start\"",
    "electron:build": "vite build && electron-builder",
    "start:all": "concurrently -k \"npm run start:backend\" \"npm run electron:dev\"",
    "start:backend": "cd backend && npm run dev"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-oauth/google": "^0.13.4",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.5.3",
    "piexifjs": "^1.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^15.0.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.auceps.wacopilote",
    "productName": "WaCopilote",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "icon": "public/assets/WaCopilot Logo.svg"
    },
    "mac": {
      "icon": "public/assets/WaCopilot Logo.svg"
    },
    "linux": {
      "icon": "public/assets/WaCopilot Logo.svg"
    }
  }
}
