{
  "name": "wacopilote",
  "private": true,
  "version": "1.52.5",
  "license": "AGPL-3.0-only",
  "main": "electron/main.cjs",
  "type": "module",
  "bin": {
    "wacopilote": "./bin/wacopilote.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c playwright.e2e.config.js",
    "lint": "eslint .",
    "cli": "node bin/wacopilote.cjs",
    "cli:mcp": "node bin/wacopilote.cjs mcp",
    "preview": "vite preview",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 tcp:3000 && npm run electron:start\"",
    "electron:build": "vite build && electron-builder",
    "electron:publish": "vite build && electron-builder -p always",
    "start:backend": "node backend/server.js",
    "start:all": "concurrently -k \"npm run start:backend\" \"npm run electron:dev\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.11",
    "i18next": "^27.2.2",
    "i18next-resources-to-backend": "^1.3.0",
    "idb-keyval": "^6.3.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.79.0",
    "papaparse": "^5.7.1",
    "piexifjs": "^1.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^15.0.0",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.1",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.auceps.wacopilote",
    "productName": "WaCopilote",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "src/components/invoice/buildInvoiceHTML.js",
      "src/components/invoice/helpers.js",
      "src/locales/fr.json",
      "!backend/__tests__/**/*",
      "!**/*.test.js",
      "!**/.env",
      "!**/.env.*",
      "package.json"
    ],
    "asarUnpack": [
      "backend/scripts/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "auceps-dev-team",
      "repo": "wacopilote-releases"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}_Setup.${ext}",
      "include": "build/installer.nsh",
      "license": "build/license.txt"
    },
    "compression": "maximum",
    "win": {
      "icon": "public/assets/WaCopilot Logo.ico"
    },
    "mac": {
      "icon": "public/assets/WaCopilot Logo.png"
    },
    "linux": {
      "icon": "public/assets/WaCopilot Logo.png"
    }
  }
}
